#!/bin/bash
# Prompt for the Gmail address, its app password and the dashboard password (no echo for the
# passwords); store them in /etc/optout/optout.env.
set -eu
ENV=/etc/optout/optout.env
set_kv() { grep -q "^$1=" "$ENV" && sed -i "s|^$1=.*|$1=$2|" "$ENV" || echo "$1=$2" >> "$ENV"; }
# values go through sed and a shell-sourced env file, so keep them to characters that survive both
plain() { case $1 in *[!A-Za-z0-9@+=:,._-]*) echo "use only letters, digits and @+=:,._- in this value" >&2; exit 1;; esac; }
read -rp "Gmail address that sends the requests (blank = keep): " gu
[ -n "$gu" ] && { plain "$gu"; set_kv GMAIL_USER "$gu"; }
read -rsp "Gmail app password (16 chars, blank = keep): " gp; echo
[ -n "$gp" ] && { plain "${gp// /}"; set_kv GMAIL_APP_PASSWORD "${gp// /}"; }
read -rsp "Dashboard password (blank = keep): " wp; echo
[ -n "$wp" ] && { plain "$wp"; set_kv OPTOUT_WEB_PASSWORD "$wp"; }
chmod 600 "$ENV"
systemctl restart optout-web.service
echo "saved"
