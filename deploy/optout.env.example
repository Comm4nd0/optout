# /etc/optout/optout.env (root 600). Secrets are written by optout-secrets.
# While OPTOUT_DRY_RUN is true no email is sent and no web form is submitted.
OPTOUT_DRY_RUN=true
OPTOUT_DAILY_LIMIT=40
OPTOUT_SEND_HOURS=9-21
GMAIL_USER=
GMAIL_APP_PASSWORD=
# With no web password the dashboard has no login and only answers on 127.0.0.1.
OPTOUT_WEB_USER=admin
OPTOUT_WEB_PASSWORD=
